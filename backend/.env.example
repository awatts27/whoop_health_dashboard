# ── WHOOP OAuth2 credentials ──────────────────────────────────────────────
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
WHOOP_ACCESS_TOKEN=your_initial_access_token
WHOOP_REFRESH_TOKEN=your_initial_refresh_token

# ── Supabase / PostgreSQL ──────────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── FastAPI ───────────────────────────────────────────────────────────────
# A strong random secret — used as Bearer token for all API requests
API_SECRET=change_me_to_a_strong_random_secret

# ── Optional metadata exposed through /summary ────────────────────────────
CURRENT_TRAINING_PHASE=hypertrophy_block
LAST_BLOODWORK_DATE=2025-01-15

# ── CORS (comma-separated origins, or * for open) ─────────────────────────
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
